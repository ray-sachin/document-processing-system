# PostgreSQL
POSTGRES_USER=dps_user
POSTGRES_PASSWORD=dps_password
POSTGRES_DB=document_processing
DATABASE_URL=postgresql+asyncpg://dps_user:dps_password@localhost:5432/document_processing
SYNC_DATABASE_URL=postgresql://dps_user:dps_password@localhost:5432/document_processing

# Application
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_PATH=./storage
STORAGE_TYPE=local
# For S3-compatible storage:
# STORAGE_TYPE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=documents

# CORS
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# File upload limits
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,csv,png,jpg,jpeg

# Processing
PROCESSING_TIMEOUT_SECONDS=300
MAX_RETRY_ATTEMPTS=3
